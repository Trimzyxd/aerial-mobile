{
  "expo": {
    "name": "Aerial Mobile",
    "slug": "aerial-mobile",
    "version": "1.0.5",
    "runtimeVersion": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "updates": {
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "url": "https://trimzyxd.github.io/aerial-mobile/ota/android.json"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#12141a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aerial.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12141a"
      },
      "package": "com.aerial.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-status-bar",
      "expo-updates"
    ]
  }
}
